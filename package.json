{
  "name": "rebellm-relay-repo",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "check:rust": "cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test",
    "lint": "eslint .",
    "format": "cargo fmt && prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check:rust && npm run lint && npm run format:check"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}

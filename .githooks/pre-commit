#!/bin/sh
# Checks the staged snapshot in a temp copy, so unstaged work cannot change the result.
root=$(git rev-parse --show-toplevel) || exit 1
# Machine settings (toolchain on PATH, build directory); never tracked.
[ -f "$root/.githooks/local.sh" ] && . "$root/.githooks/local.sh"
# A fixed name keeps the build fingerprints of the dependencies valid between commits.
tmp="${TMPDIR:-/tmp}/rebellm-relay-precommit"

case "$(uname -s)" in
MINGW* | MSYS* | CYGWIN*) win=1 ;;
*) win=0 ;;
esac

link() {
  [ -d "$1" ] || return 0
  if [ $win = 1 ]; then
    MSYS_NO_PATHCONV=1 cmd.exe /c mklink /J "$(cygpath -w "$2")" "$(cygpath -w "$1")" >/dev/null || return 1
  else
    ln -s "$1" "$2" || return 1
  fi
}

cleanup() {
  # Remove the link first so the recursive delete never follows it into the real node_modules.
  if [ -e "$tmp/node_modules" ]; then
    if [ $win = 1 ]; then
      MSYS_NO_PATHCONV=1 cmd.exe /c rmdir "$(cygpath -w "$tmp/node_modules")" >/dev/null 2>&1
    else
      rm -f "$tmp/node_modules"
    fi
  fi
  [ -e "$tmp/node_modules" ] || rm -rf "$tmp"
}
# A copy left by a killed run.
cleanup
trap cleanup EXIT INT TERM

mkdir -p "$tmp" || exit 1
git checkout-index -a --prefix="$tmp/" || exit 1
link "$root/node_modules" "$tmp/node_modules" || exit 1
if [ -f "$root/.cargo/config.toml" ]; then
  mkdir -p "$tmp/.cargo" && cp "$root/.cargo/config.toml" "$tmp/.cargo/config.toml" || exit 1
elif [ -z "$CARGO_TARGET_DIR" ]; then
  # Share the build with the working tree instead of compiling everything in the copy.
  CARGO_TARGET_DIR="$root/target"
  export CARGO_TARGET_DIR
fi

start=$(date +%s)
(cd "$tmp" && npm run --silent check)
status=$?
echo "pre-commit: checks $([ $status = 0 ] && echo passed || echo FAILED) in $(($(date +%s) - start)) s" >&2
exit $status
